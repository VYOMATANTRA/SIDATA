# Frontend env for running Vite on the host (`npm run dev` in frontend/).
# Vite reads THIS file (frontend/.env), not the repository-root .env.
# Under Docker Compose the frontend container gets its values from the root .env instead.
#
#   cp .env.example .env

# Backend URL the Vite dev proxy forwards /api to.
VITE_API_URL=http://localhost:3000

# Cloudflare's always-pass test site key; must pair with TURNSTILE_SECRET in the root .env.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
