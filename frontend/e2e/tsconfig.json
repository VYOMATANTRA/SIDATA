{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*.ts"],
  "exclude": [".output"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  }
}
