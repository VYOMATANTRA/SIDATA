# Backend server
PORT=3000
NODE_ENV=development

# MySQL connection string: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://root:password@localhost:3306/sidata

# JWT signing secrets — use long random strings, never commit real values
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CSRF_SECRET=change-me-again
COOKIE_ENCRYPTION_KEY=change-me-cookie-encryption-secret

# Frontend origin allowed to make credentialed requests to this API
CORS_ORIGIN=http://localhost:5173

# BMKG adm4 area code used by the weather forecast feature (optional defaults to
# Kelurahan Manggar, Balikpapan Timur if unset). Verify against BMKG's official wilayah list
# before changing.
WEATHER_ADM4=64.71.01.1001

# Weather forecast cache tuning (both optional, values in ms). WEATHER_CACHE_TTL_MS is how long
# a fresh BMKG forecast is served before re-fetching (defaults to 1 hour). WEATHER_STALE_RETRY_MS
# is the backoff window after a failed BMKG refresh before retrying (defaults to 5 minutes).
WEATHER_CACHE_TTL_MS=3600000
WEATHER_STALE_RETRY_MS=300000

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
GOOGLE_OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth_failed

# TTL (seconds) for the temporary oauth_state/oauth_verifier cookies during the OAuth
# handshake. Optional — both default to 300.
OAUTH_STATE_TTL_SECONDS=300
OAUTH_PKCE_TTL_SECONDS=300

# Cloudflare Turnstile anti-bot secret (1x0000000000000000000000000000000AA is Cloudflare always-pass test key)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Email Service: Resend API Key (Optional in local dev, required for transactional emails)
RESEND_API_KEY=re_1234567890abcdef
EMAIL_FROM="SIDATA Kelurahan Manggar <onboarding@resend.dev>"
