# Backend server
PORT=3000
NODE_ENV=development

# MySQL connection string: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://root:password@localhost:3306/sidata

# JWT signing secrets — use long random strings, never commit real values
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Frontend origin allowed to make credentialed requests to this API
CORS_ORIGIN=http://localhost:5173
