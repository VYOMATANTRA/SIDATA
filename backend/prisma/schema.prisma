// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]

  @@map("roles")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password_hash String?
  auth_provider String         @default("local")
  provider_id   String?
  email_verified Boolean       @default(false)
  requires_password_change Boolean @default(false)
  deletedAt     DateTime?
  roleId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  role          Role           @relation(fields: [roleId], references: [id])
  RefreshTokens RefreshToken[]
  EmailOtps     EmailOtp[]

  AuditLogsAsActor       AuditLog[]      @relation("AuditLogActor")
  AuditLogsAcknowledged  AuditLog[]      @relation("AuditLogAcknowledgedBy")
  SystemSettingsUpdated  SystemSetting[] @relation("SystemSettingUpdatedBy")

  @@index([auth_provider, provider_id])
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     String
  token      String   @unique @db.VarChar(512)
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_otps")
}

enum SpatialPointType {
  ketua_rt
  bank_sampah
  fasilitas_umum
}

model SpatialPoint {
  id        String           @id @default(uuid())
  name      String
  type      SpatialPointType
  latitude  Float
  longitude Float
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rtCoverages SpatialPointRt[]

  @@index([type])
  @@map("spatial_points")
}

model SpatialPointRt {
  id       Int          @id @default(autoincrement())
  pointId  String       @map("point_id")
  rtNumber Int          @map("rt_number")

  point    SpatialPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([pointId, rtNumber])
  @@index([rtNumber])
  @@index([pointId])
  @@map("spatial_point_rt")
}

model RtLeader {
  rtNumber        Int      @id @map("rt_number")
  name            String
  phone           String
  phoneIsWhatsapp Boolean  @default(true) @map("phone_is_whatsapp")
  alamat          String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rt_leaders")
/// Append-only audit trail. Rows are inserted by the app's runtime DB user and never updated
/// or deleted by it, other than the two acknowledge columns below — see backend/scripts/grants/
/// audit-logs-grants.sql for the DB-level enforcement and src/utils/prisma.ts for the app-level
/// guard. targetId/targetType are intentionally not a foreign key: this table is also the future
/// home for CMS content-edit logging (SPEC.md §7 "override logs"), whose tables don't exist yet.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  outcome   String   @default("success")
  severity  String   @default("info")

  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AuditLogAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  actorId    String?
  actor      User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  String?

  targetType  String?
  targetId    String?
  targetLabel String?

  metadata  Json?
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([severity, acknowledgedAt])
  @@map("audit_logs")
}

/// Generic key/value settings store. First use is admin-configurable audit log retention
/// (see backend/src/services/settings.service.ts); the CMS work in SPEC.md §7 is expected
/// to want a home for its own settings here too.
model SystemSetting {
  key   String @id @map("setting_key")
  value String

  updatedById String?
  updatedBy   User?   @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}