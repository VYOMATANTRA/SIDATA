// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]

  @@map("roles")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password_hash String?
  auth_provider String         @default("local")
  provider_id   String?
  email_verified Boolean       @default(false)
  roleId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  role          Role           @relation(fields: [roleId], references: [id])
  RefreshTokens RefreshToken[]
  EmailOtps     EmailOtp[]

  @@index([auth_provider, provider_id])
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_otps")
}

enum SpatialPointType {
  ketua_rt
  bank_sampah
  fasilitas_umum
}

model SpatialPoint {
  id        String           @id @default(uuid())
  name      String
  type      SpatialPointType
  latitude  Float
  longitude Float
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rtCoverages SpatialPointRt[]

  @@index([type])
  @@map("spatial_points")
}

model SpatialPointRt {
  id       Int          @id @default(autoincrement())
  pointId  String       @map("point_id")
  rtNumber Int          @map("rt_number")

  point    SpatialPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  rtLeader RtLeader?    @relation(fields: [rtNumber], references: [rtNumber], onDelete: Cascade)

  @@unique([pointId, rtNumber])
  @@index([rtNumber])
  @@index([pointId])
  @@map("spatial_point_rt")
}

model RtLeader {
  rtNumber        Int              @id @map("rt_number")
  name            String
  phone           String
  phoneIsWhatsapp Boolean          @default(true) @map("phone_is_whatsapp")
  alamat          String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  spatialPoints   SpatialPointRt[]

  @@map("rt_leaders")
}