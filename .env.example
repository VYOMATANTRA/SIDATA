# Docker Compose environment — see docker-compose.yml.
# Keep DATABASE_URL in sync with the MYSQL_* values below: docker compose does not expand
# variables inside .env files, so this string must be assembled by hand.

MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=sidata
MYSQL_USER=sidata
MYSQL_PASSWORD=changeme

NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL=mysql://sidata:changeme@mysql:3306/sidata

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# Passed through to the backend container (see backend/.env.example for details)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CSRF_SECRET=change-me-again
CORS_ORIGIN=http://localhost:5173

# Google OAuth Configuration (Lokal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
GOOGLE_OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth_failed

# TTL Cookie OAuth (Opsional, Default 300 detik)
OAUTH_STATE_TTL_SECONDS=300
OAUTH_PKCE_TTL_SECONDS=300

# Turnstile Anti-Bot
TURNSTILE_SECRET=0x1AAAAAAAAAAAA
VITE_TURNSTILE_SITE_KEY=0x1AAAAAAAAAAAAAAAAAA


EMAIL_FROM=SIDATAKelurahanManggar<onboarding@resend.dev>

