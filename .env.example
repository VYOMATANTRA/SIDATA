# Environment configuration — used for both local development and Docker Compose (see docker-compose.yml).
# Keep DATABASE_URL in sync with the MYSQL_* values below: docker compose does not expand
# variables inside .env files, so this string must be assembled by hand.
# For local (non-Docker) development, change the host in DATABASE_URL from 'mysql' to 'localhost'
# (e.g., mysql://sidata:changeme@localhost:3306/sidata).

MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=sidata
MYSQL_USER=sidata
MYSQL_PASSWORD=changeme

NODE_ENV=development
BACKEND_PORT=3000
# Database connection: host 'mysql' is for Docker Compose; change to 'localhost' for local non-Docker development
DATABASE_URL=mysql://sidata:changeme@mysql:3306/sidata

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
# Used only by the frontend container's Vite dev proxy (see docker-compose.yml) — must resolve
# on the Compose network, not on the host, so it points at the backend service name, not localhost.
VITE_API_URL_DOCKER=http://backend:3000

# Backend auth & security configuration (used by local backend and Docker Compose)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CSRF_SECRET=change-me-again
COOKIE_ENCRYPTION_KEY=change-me-cookie-encryption-secret
CORS_ORIGIN=http://localhost:5173

# Google OAuth Configuration (Lokal)
# The backend refuses to boot if these are empty. The placeholders below let it start, but
# "Sign in with Google" only works with real credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=dev-placeholder
GOOGLE_CLIENT_SECRET=dev-placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
GOOGLE_OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth_failed

# TTL Cookie OAuth (Opsional, Default 300 detik)
OAUTH_STATE_TTL_SECONDS=300
OAUTH_PKCE_TTL_SECONDS=300

# Turnstile Anti-Bot — these are Cloudflare's official always-pass TEST keys, fine for local dev.
# VITE_TURNSTILE_SITE_KEY here feeds the Docker frontend only; for a frontend run on the host,
# set it in frontend/.env (see frontend/.env.example).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# Resend API key for transactional email (OTP delivery). The placeholder lets the backend boot,
# but no email is sent: sign in locally with the dev admin (`npm run dev:seed`, see README).
RESEND_API_KEY=re_1234567890abcdef
EMAIL_FROM="SIDATA Kelurahan Manggar <onboarding@resend.dev>"

# Express `trust proxy` setting. Optional — leave unset for local/non-proxied dev. Set this in
# any deployment sitting behind a reverse proxy (the Docker/VPS target), or req.ip resolves to
# the proxy's address on every rate-limiter bucket (including pre-auth IP flood guards such as
# comparison template preview), CSRF session key, and audit-log row.
# Accepts 'true'/'false', a hop count ('1'), or any value Express's trust-proxy parser accepts
# (e.g. 'loopback').
TRUST_PROXY=

# Privileged DB connection used ONLY by backend/scripts/ (audit-log retention pruning, the
# audit_logs grant script) — never by the running server. Must be a DIFFERENT, more-privileged
# user than DATABASE_URL once backend/scripts/grants/audit-logs-grants.sql has been applied
# (that script strips DATABASE_URL's user down to no-DELETE on audit_logs). See AGENTS.md
# "Audit Trail". Leave unset if you haven't set up audit-log pruning yet.
AUDIT_ADMIN_DATABASE_URL=

# Cron schedule (5 fields) for the opt-in `audit-pruner` Compose sidecar
# (`docker compose --profile ops up -d --build audit-pruner`). Requires AUDIT_ADMIN_DATABASE_URL.
# Defaults to daily at 03:00 container time when unset.
# AUDIT_PRUNE_SCHEDULE=0 3 * * *

# Set to 0 on the Compose `backend` service once the audit grants script is applied: the app user
# can no longer run migrations, so run them as the privileged user instead (see docs/DEPLOYMENT.md).
# RUN_MIGRATIONS=1

# Where uploaded media (photos, documents, data files) is stored on disk.
# In development and test, optional — unset/empty defaults to <repo-root>/uploads.
# In production (NODE_ENV=production), an explicit UPLOAD_DIR is required; if unset, media
# storage initialization fails with UploadRootError and media routes degrade to 503 Service Unavailable.
# A relative path resolves against the repository root (not the working directory); an absolute
# path is used as-is. The server creates it at boot, checks it is writable, and, if it is unusable
# (not writable, or inside backend/ or frontend/), logs a loud WARNING and keeps serving everything
# except media (503 until fixed). Never exposed by the API.
# Under Docker Compose this is fixed to /var/lib/sidata/uploads inside the container; use
# UPLOADS_HOST_DIR to choose the host directory that is bind-mounted there (default ./uploads).
# UPLOAD_DIR=
# UPLOADS_HOST_DIR=./uploads

# Grace period (hours, default 24) used by `npm run media:cleanup` (under Compose cron, run
# `docker compose exec -T backend npm run media:cleanup`) before it removes stale staging
# directories and unattached uploads (aged from the moment content detached them, else from the
# upload). The --grace-hours flag overrides it.
# MEDIA_CLEANUP_GRACE_HOURS=24

# Maximum concurrent photo re-encoding operations (sharp). Optional integer 1-8, default 2.
# Excess upload requests wait in a queue (max 20); past the queue, requests are rejected with
# 503 Service Unavailable and a Retry-After: 5 header.
# MEDIA_IMAGE_CONCURRENCY=2

